{
  "redirects": [
  { "source": "/", "destination": "/agentic-majlis/", "permanent": false },
  { "source": "/agentic-majlis", "destination": "/agentic-majlis/", "permanent": false }
],
  "rewrites": [
    { "source": "/agentic-majlis/", "destination": "/index.html" },
    { "source": "/agentic-majlis/:path*", "destination": "/:path*" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
